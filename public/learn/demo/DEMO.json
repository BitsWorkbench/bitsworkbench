{
  "format": 1,
  "id": "DEMO",
  "title": "{app} demo",
  "brief": "Drive CodeBot in the simulator, in a few minutes.",
  "board": "codebot",
  "runs": "sim",
  "licence": "Part of {app}, MIT licensed.",
  "avatar": "FL_DevicesAvatar.png",
  "complete": "--Blocks--**You coded a robot!** Every block you used is a line of Python, and the Python is what CodeBot runs. Want to try the same thing in Python?--/Blocks----Python--**You coded a robot in Python!** It is the same Python a real CodeBot runs. Pick a mission pack from **Learn** to keep going.--/Python--",
  "missions": [
    {
      "id": "DEMO_Drive",
      "title": "Drive CodeBot",
      "brief": "Run a program, change it, run it again.",
      "avatar": "Cb2Icon-128.png",
      "flow": [
        {
          "type": "journey",
          "id": "DEMO_Drive_J",
          "title": "Drive CodeBot",
          "file": "demo.py",
          "promise": "Meet CodeBot, a robot you code with blocks. In a few steps you will make it drive and light up, right here on screen.",
          "chapters": [
            {
              "id": "DEMO_C1",
              "title": "Drive",
              "code": "from botcore import *\nimport time\n\nmotors.enable(True)\n\nmotors.run(LEFT, 50)\nmotors.run(RIGHT, 50)\ntime.sleep(1)\nmotors.run(LEFT, 0)\nmotors.run(RIGHT, 0)\n",
              "steps": [
                { "id": "DEMO_look", "goal": "Look around CodeBot", "say": "This is **CodeBot**, in the simulator. Drag it to look around.", "point": "sim", "do": { "event": "orbit" }, "skippable": true, "cheer": "Nice view!" },
                { "id": "DEMO_run", "goal": "Run your program", "say": "--Blocks--These blocks are your program: they--/Blocks----Python--This Python is your program: it--/Python-- drive CodeBot forward for one second. Press **▶ Run**.", "point": "run", "do": { "runs": true }, "cheer": "It drove!" },
                {
                  "id": "DEMO_power", "goal": "Drive at full power",
                  "say": "--Blocks--Click the **50** and make it **100**: full power.--/Blocks----Python--Change **both** 50s to **100**: full power for each wheel.--/Python--",
                  "point": "field:motors.run(LEFT, ...)",
                  "do": { "all": [{ "has": "motors.run(LEFT, 100)" }, { "has": "motors.run(RIGHT, 100)" }] },
                  "hints": ["--Blocks--The 50 is in the orange **drive** block. Click it, type 100, then click away.--/Blocks----Python--`motors.run(LEFT, 50)` and `motors.run(RIGHT, 50)`: click just after each 50, delete it, type 100.--/Python--"],
                  "cheer": "Full power!"
                },
                { "id": "DEMO_run2", "goal": "Run it again", "say": "Press **▶ Run** again.", "point": "run", "do": { "runs": true }, "cheer": "Faster and further!" }
              ]
            },
            {
              "id": "DEMO_C2",
              "title": "Lights",
              "steps": [
                { "id": "DEMO_palette", "goal": "Open Lights", "say": "--Blocks--Blocks live in the palette.--/Blocks----Python--The palette has Python too.--/Python-- Open **Lights**.", "point": "palette:lights", "do": { "event": "palette", "name": "lights" } },
                {
                  "id": "DEMO_leds", "goal": "Add the top LEDs",
                  "say": "--Blocks--Drag **turn all top LEDs on** under your drive block.--/Blocks----Python--Click the last line of your program, open **Lights**, and click the **leds.user** card: it goes in under that line.--/Python--",
                  "point": "palette-item:leds.user(...)",
                  "palette": "lights",
                  "to": "after:time.sleep(...)",
                  "do": { "has": "leds.user(...)" },
                  "fx": ["ghost"],
                  "cheer": "Snapped in."
                },
                { "id": "DEMO_run3", "goal": "Run: drive, then lights", "say": "Run it: motion, then lights.", "point": "run", "do": { "runs": true }, "cheer": "Lights on!" },
                {
                  "id": "DEMO_ask",
                  "ask": "--Blocks--Your blocks are a Python program underneath.--/Blocks-- Which line drives CodeBot?",
                  "answers": [{ "a": "`leds.user(0xFF)`" }, { "a": "`motors.run(LEFT, 100)`", "correct": true }, { "a": "`import time`" }],
                  "cheer": "Right: blocks in, Python out."
                }
              ]
            }
          ],
          "complete": "CodeBot drove at full power and lit up, all from your blocks."
        }
      ]
    }
  ],
  "assets": {
      "FL_DevicesAvatar.png": "data:image/png;base64,",
      "Cb2Icon-128.png": "data:image/png;base64,"
  }
}
